# Copia este archivo a .env y cambia TODOS los secretos. Nunca subas .env al repositorio.
# Genera secretos con:  openssl rand -base64 48

# --- Local (tu PC) ---
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost:8088
HTTP_PORT=8088
HTTPS_PORT=8443
# En local no hay HTTPS: la cookie de sesión no puede ser "Secure".
COOKIE_SECURE=false

# --- Producción (VPS con dominio apuntando a su IP) ---
# SITE_ADDRESS=app.mandao.co
# PUBLIC_URL=https://app.mandao.co
# HTTP_PORT=80
# HTTPS_PORT=443
# COOKIE_SECURE=true

# Secretos
DB_PASSWORD=cambia-esta-clave-de-base-de-datos
JWT_SECRET=cambia-este-secreto-jwt-de-al-menos-32-caracteres
OTP_KEY=cambia-esta-frase-para-cifrar-los-codigos-otp

# Archivos: "local" (volumen Docker) o "s3" (AWS S3 / compatible)
STORAGE_TYPE=local
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=mandao-files

# Notificaciones push (spec 012). Genera el par UNA sola vez y no lo cambies (invalidaría las suscripciones):
#   docker compose build backend
#   docker compose run --rm --no-deps --entrypoint java backend -Dloader.main=com.mandao.notifications.VapidKeyGenerator -cp app.jar org.springframework.boot.loader.launch.PropertiesLauncher
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@mandao.co

# Operación
WHATSAPP_NUMBER=573000000000
# Primer administrador (se crea al arrancar si no existe)
ADMIN_PHONE=3009999999
ADMIN_PASSWORD=CambiaEsta2026
# Datos de demostración (mandaderos y clientes de prueba en Valledupar). Solo para pruebas.
SEED_DEMO=false
SWAGGER_ENABLED=false
